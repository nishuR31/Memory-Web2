# LLM
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_INPUT_PRICE_PER_1M=0.075
GEMINI_OUTPUT_PRICE_PER_1M=0.30

# Keep existing Groq for fallback/comparison only
GROQ_API_KEY=your_existing_key

# TigerGraph
TIGERGRAPH_HOST=your-savanna-host
TIGERGRAPH_PORT=14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password
TIGERGRAPH_GRAPH=FinancialCrimeGraph

# GraphRAG Service
GRAPHRAG_URL=http://localhost:8000

# Vector DB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_PORT=8000

# Dataset
DATASET_TOKEN_COUNT=913931776
DATASET_COUNT_MODEL=gemini-1.5-flash

# Optional OpenAI compatibility
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_INFERENCE_MODEL=llama-3.1-8b-instant

# Pipeline model overrides (legacy compatibility)
LLM_ONLY_MODEL=gemini-1.5-flash
VECTOR_RAG_MODEL=gemini-1.5-flash
GRAPHRAG_MODEL=gemini-1.5-flash

# Feature toggles
GRAPHRAG_USE_LLM=true
HACKATHON_DEMO_MODE=false

# Frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173

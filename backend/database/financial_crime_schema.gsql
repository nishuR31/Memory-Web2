CREATE GRAPH FinancialCrimeGraph()

USE GRAPH FinancialCrimeGraph

CREATE VERTEX Company (PRIMARY_ID id STRING, name STRING, jurisdiction STRING, risk_score INT) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Person (PRIMARY_ID id STRING, full_name STRING, pep BOOL, risk_score INT) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX BankAccount (PRIMARY_ID id STRING, bank_name STRING, country STRING, risk_score INT) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Address (PRIMARY_ID id STRING, country STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, amount DOUBLE, currency STRING, tx_date DATETIME) WITH PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Document (PRIMARY_ID id STRING, source STRING, published_at DATETIME) WITH PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE UNDIRECTED EDGE OWNS (FROM Company, TO Company, pct DOUBLE)
CREATE UNDIRECTED EDGE CONTROLS (FROM Person, TO Company, role STRING)
CREATE UNDIRECTED EDGE SHARES_ADDRESS (FROM Company, TO Address)
CREATE DIRECTED EDGE TRANSACTS_WITH (FROM Company, TO Company, amount DOUBLE, currency STRING, tx_date DATETIME)
CREATE UNDIRECTED EDGE MENTIONED_IN (FROM Company, TO Document)
CREATE UNDIRECTED EDGE SANCTIONED (FROM Company, TO Company, sanction_program STRING)

		{
			"label": "Install Backend Dependencies",
			"type": "shell",
			"command": "cd backend && /Applications/Xcode.app/Contents/Developer/usr/bin/python3 -m pip install -r requirements.txt"
		},
		{
			"label": "Run Backend Server",
			"type": "shell",
			"command": "cd backend && /Applications/Xcode.app/Contents/Developer/usr/bin/python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000"
